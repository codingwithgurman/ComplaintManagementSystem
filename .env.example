# CampusDesk environment variables
# Copy this file to .env.local: cp .env.example .env.local
# Never commit .env.local to version control.

# =========================================================
# Supabase (PostgreSQL Database & Image Storage)
# Obtain from: Supabase Dashboard > Project Settings > API Keys
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Optional service role key for server operations (if configured):
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =========================================================
# Local Authentication Session
# Optional secret used to sign session cookies. If unset, a fallback secret is used.
# =========================================================
SESSION_SECRET=create-a-random-secret-key-here-min-32-chars

# =========================================================
# Groq (Optional: Required only for the AI Help Desk)
# Obtain from: https://console.groq.com/keys
# =========================================================
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
